/*
 * Azoteq IQS5xx (TPS65) touchpad add-on for the Swifty keyboard
 * running on nice_nano (nRF52840).
 *
 * SoC pin assignment (use the free pins on the Swifty PCB):
 *   P0.13 -> TPS65 SDA
 *   P0.15 -> TPS65 SCL
 *   P0.17 -> TPS65 RDY    (active-high, open-drain; pull-up applied)
 *   P0.19 -> TPS65 NRST   (active-low; optional)
 *   3V3   -> TPS65 VDD
 *   GND   -> TPS65 GND
 *
 * Reuses i2c0 with custom pinctrl so the default SDA/SCL pin
 * defaults are not touched.
 */

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>,
                    <NRF_PSEL(TWIM_SCL, 0, 15)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>,
                    <NRF_PSEL(TWIM_SCL, 0, 15)>;
            low-power-enable;
        };
    };

    /*
     * Stub: swifty.dtsi references &i2s0_default_alt but no group is
     * defined anywhere. Provide a no-op group so the DT parses;
     * i2s0 itself is disabled below.
     */
    i2s0_default_alt: i2s0_default_alt {
        group1 {
            psels = <NRF_PSEL_DISCONNECTED(I2S_SDOUT)>;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    tps65: iqs5xx@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        rdy-gpios   = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;

        scroll;
    };
};

/ {
    tps65_listener: tps65_listener {
        compatible = "zmk,input-listener";
        device = <&tps65>;
    };
};

/*
 * swifty.dtsi references &i2s0_default_alt which is not defined
 * anywhere in this tree (pre-existing incomplete WS2812 wiring).
 * Disable i2s0 here so the touchpad build succeeds without dragging
 * in unrelated underglow work.
 */
&i2s0 {
    status = "disabled";
};

/*
 * nice_nano's upstream overlay declares an EXT_POWER node on
 * P0.13; swifty.dtsi declares its own ext_power on P1.6. Both
 * normalize to the same DT macro name. Drop the upstream one for
 * this build.
 */
/ {
    /delete-node/ EXT_POWER;
};

