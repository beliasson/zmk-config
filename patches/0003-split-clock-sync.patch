+/* The two halves run on independent crystals, so the arrival time of a
+ * notification carries the link's latency on top of the real clock difference.
+ * A round trip removes that: the peripheral stamps when it answers, so its
+ * receipt and reply times collapse into one value and the offset is simply
+ * T2 - (T1 + T4) / 2, with the round trip itself bounding how much asymmetry
+ * can be hiding in it. Probing on a timer rather than inferring from key
+ * traffic also keeps the estimate current while the keyboard sits idle. */
+#define SPLIT_CLOCK_PROBE_INTERVAL_MS 15000
+/* Skip probes whose round trip is much worse than the best seen: their
+ * asymmetry error would otherwise bias the estimate for the next interval. */
+#define SPLIT_CLOCK_PROBE_RTT_SLACK_MS 5
+
+static void split_central_clock_probe_work_cb(struct k_work *work);
+
+K_WORK_DELAYABLE_DEFINE(clock_probe_work, split_central_clock_probe_work_cb);
+
+static uint8_t split_central_clock_probe_read_func(struct bt_conn *conn, uint8_t err,
+                                                   struct bt_gatt_read_params *params,
+                                                   const void *data, uint16_t length);
+
+static void split_central_probe_clock(struct peripheral_slot *slot) {
+    if (slot->state != PERIPHERAL_SLOT_STATE_CONNECTED || slot->conn == NULL ||
+        slot->subscribe_params.value_handle == 0 || slot->probe_in_flight) {
+        return;
+    }
+
+    slot->pos_read_params.func = split_central_clock_probe_read_func;
+    slot->pos_read_params.handle_count = 1;
+    slot->pos_read_params.single.handle = slot->subscribe_params.value_handle;
+    slot->pos_read_params.single.offset = 0;
+
+    slot->probe_t1 = k_uptime_get_32();
+    slot->probe_in_flight = true;
+
+    int err = bt_gatt_read(slot->conn, &slot->pos_read_params);
+    if (err) {
+        LOG_WRN("Failed to start the clock probe read (err %d)", err);
+        slot->probe_in_flight = false;
+    }
+}
+
+static void split_central_clock_probe_work_cb(struct k_work *work) {
+    for (int i = 0; i < ZMK_SPLIT_BLE_PERIPHERAL_COUNT; i++) {
+        split_central_probe_clock(&peripherals[i]);
+    }
+
+    k_work_reschedule(&clock_probe_work, K_MSEC(SPLIT_CLOCK_PROBE_INTERVAL_MS));
+}
+
+static uint8_t split_central_clock_probe_read_func(struct bt_conn *conn, uint8_t err,
+                                                   struct bt_gatt_read_params *params,
+                                                   const void *data, uint16_t length) {
+    struct peripheral_slot *slot = peripheral_slot_for_conn(conn);
+
+    if (slot == NULL) {
+        return BT_GATT_ITER_STOP;
+    }
+
+    slot->probe_in_flight = false;
+
+    if (err > 0 || data == NULL) {
+        LOG_WRN("Clock probe failed (err %u, length %u)", err, length);
+        return BT_GATT_ITER_STOP;
+    }
+
+    if (length < POSITION_STATE_DATA_LEN + sizeof(uint32_t)) {
+        /* A peripheral built without the timestamp: nothing to correct with. */
+        return BT_GATT_ITER_STOP;
+    }
+
+    uint32_t t4 = k_uptime_get_32();
+    uint32_t t2;
+    memcpy(&t2, (const uint8_t *)data + POSITION_STATE_DATA_LEN, sizeof(t2));
+
+    uint32_t half_rtt = (t4 - slot->probe_t1) / 2;
+    int32_t probe_offset = (int32_t)(t2 - (slot->probe_t1 + half_rtt));
+
+    if (slot->half_rtt_min == 0 || half_rtt < slot->half_rtt_min) {
+        slot->half_rtt_min = half_rtt;
+    }
+
+    if (!slot->clock_offset_valid ||
+        half_rtt <= slot->half_rtt_min + SPLIT_CLOCK_PROBE_RTT_SLACK_MS) {
+        slot->clock_offset = probe_offset;
+        slot->clock_offset_valid = true;
+        LOG_DBG("Clock offset %d from a %u ms half round trip", probe_offset, half_rtt);
+    }
+
+    return BT_GATT_ITER_STOP;
+}
